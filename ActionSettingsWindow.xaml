<Window x:Class="LunaDesktopHelper.ActionSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="快捷操作设置" Width="660" Height="680" MinWidth="520" MinHeight="380"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        ShowInTaskbar="True" Background="#171D28" Foreground="#F5F7FC">
  <Window.Resources>
    <Style x:Key="RecorderBox" TargetType="TextBox">
      <Setter Property="Height" Value="38" />
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="IsReadOnly" Value="True" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="#222A38" />
      <Setter Property="Foreground" Value="#F5F7FC" />
      <Setter Property="BorderBrush" Value="#526075" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding DataContext.ManualEntryEnabled, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
          <Setter Property="IsReadOnly" Value="False" />
          <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="SectionCard" TargetType="Border">
      <Setter Property="Background" Value="#1E2633" />
      <Setter Property="BorderBrush" Value="#39465A" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="14" />
      <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
  </Window.Resources>

  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Margin="0,0,0,14">
      <TextBlock Text="快捷操作设置" FontSize="20" FontWeight="SemiBold" />
      <Grid Margin="0,6,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="菜单按钮按下方顺序显示。拖动左侧排序手柄，或用 ↑ ↓ 调整顺序；点击快捷键框后直接按下组合键。"
                   Foreground="#B4BECE" FontSize="12.5" TextWrapping="Wrap" />
        <CheckBox Grid.Column="1" Content="手动编辑" IsChecked="{Binding ManualEntryEnabled}"
                  Margin="16,0,0,0" VerticalAlignment="Top" Foreground="#F5F7FC" FontSize="12.5"
                  ToolTip="系统快捷键无法录制时，可手动输入组合键" />
      </Grid>
    </StackPanel>

    <Grid Grid.Row="1" Margin="1,0,0,10">
      <TextBlock Text="菜单按钮" Foreground="#AFCBFF" FontWeight="SemiBold" VerticalAlignment="Center" />
      <Button Content="＋ 新增按钮" HorizontalAlignment="Right" Padding="12,6" Click="AddAction_Click" />
    </Grid>

    <ScrollViewer x:Name="ActionsScrollViewer" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  AllowDrop="True" PreviewDragOver="ActionsScrollViewer_PreviewDragOver">
      <ItemsControl ItemsSource="{Binding Actions}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource SectionCard}" AllowDrop="True"
                    DragOver="ActionRow_DragOver" DragLeave="ActionRow_DragLeave" Drop="ActionRow_Drop">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Border Grid.Column="0" Width="28" Height="38" Background="Transparent" Cursor="SizeAll"
                          Tag="{Binding}" ToolTip="按住拖动调整顺序" AutomationProperties.Name="拖动此按钮调整顺序"
                          MouseLeftButtonDown="DragHandle_MouseLeftButtonDown" MouseMove="DragHandle_MouseMove"
                          MouseLeftButtonUp="DragHandle_MouseLeftButtonUp">
                    <TextBlock Text="≡" FontSize="21" Foreground="#9EABBD" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <CheckBox Grid.Column="1" IsChecked="{Binding Enabled}" VerticalAlignment="Center" Margin="0,0,9,0" ToolTip="在主菜单中启用此按钮" />
                  <TextBox Grid.Column="2" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" MaxLength="32"
                           Height="38" Padding="10,5" Background="#222A38" Foreground="#F5F7FC"
                           BorderBrush="#526075" VerticalContentAlignment="Center" AutomationProperties.Name="按钮名称" />
                  <Button Grid.Column="3" Content="↑" Width="34" Height="34" Margin="8,0,0,0" Tag="{Binding}" Click="MoveUp_Click" ToolTip="上移" />
                  <Button Grid.Column="4" Content="↓" Width="34" Height="34" Margin="6,0,0,0" Tag="{Binding}" Click="MoveDown_Click" ToolTip="下移" />
                  <Button Grid.Column="5" Content="删除" Height="34" Margin="6,0,0,0" Padding="9,4" Tag="{Binding}" Click="RemoveAction_Click" />
                </Grid>

                <Grid Margin="0,10,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="执行快捷键" VerticalAlignment="Center" Foreground="#B4BECE" />
                  <TextBox Grid.Column="1" Style="{StaticResource RecorderBox}" Text="{Binding Shortcut, UpdateSourceTrigger=PropertyChanged}"
                           Tag="{Binding}"
                           PreviewKeyDown="Hotkey_PreviewKeyDown" PreviewKeyUp="Hotkey_PreviewKeyUp"
                           AutomationProperties.AutomationId="ExecuteShortcut" AutomationProperties.Name="录制或手动输入执行快捷键" />
                  <TextBlock Grid.Column="2" Text="必填" Margin="8,0,0,0"
                             Foreground="#8995A7" VerticalAlignment="Center" />
                </Grid>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <TextBlock x:Name="ErrorText" Grid.Row="3" Foreground="#FFB4A9" FontSize="12"
               Margin="2,10,2,4" TextWrapping="Wrap" MinHeight="20" />

    <Grid Grid.Row="4" Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Button Content="取消" Height="46" Click="Cancel_Click" FontSize="14" AutomationProperties.Name="取消快捷操作设置" />
      <Button Grid.Column="2" Content="应用设置" Height="46" Click="Save_Click" FontSize="14" AutomationProperties.Name="应用快捷操作设置" />
    </Grid>
  </Grid>
</Window>
