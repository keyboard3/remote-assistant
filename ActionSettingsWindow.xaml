<Window x:Class="LunaDesktopHelper.ActionSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="快捷操作设置" Width="660" Height="680" MinWidth="520" MinHeight="380"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        ShowInTaskbar="True" Background="#111522" Foreground="{StaticResource Ink}">
  <Window.Resources>
    <Style x:Key="RecorderBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="IsReadOnly" Value="True" />
      <Style.Triggers>
        <Trigger Property="IsKeyboardFocusWithin" Value="True">
          <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
          <Setter Property="Background" Value="#171E30" />
        </Trigger>
        <DataTrigger Binding="{Binding DataContext.ManualEntryEnabled, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
          <Setter Property="IsReadOnly" Value="False" />
          <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="SectionCard" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Surface}" />
      <Setter Property="BorderBrush" Value="{StaticResource Stroke}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="14" />
      <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
    <Style x:Key="SmallIconButton" TargetType="Button" BasedOn="{StaticResource MenuUtilityButtonStyle}">
      <Setter Property="Width" Value="34" />
      <Setter Property="Height" Value="34" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="#141A28" />
      <Setter Property="BorderBrush" Value="{StaticResource Stroke}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
  </Window.Resources>

  <Grid Margin="26,18,26,22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="快捷操作" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Text="调整顺序和执行按键"
                   Foreground="{StaticResource MutedInk}" FontSize="11.5" Margin="0,3,0,0" />
      </StackPanel>
      <Border Grid.Column="1" Background="{StaticResource AccentSoft}" BorderBrush="#465A91"
              BorderThickness="1" CornerRadius="10" Padding="10,7" VerticalAlignment="Center">
        <CheckBox Content="手动输入" IsChecked="{Binding ManualEntryEnabled}"
                  FontSize="12" ToolTip="系统快捷键无法录制时，可手动输入组合键" />
      </Border>
    </Grid>

    <Grid Grid.Row="1" Margin="2,0,2,11">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="菜单按钮" Foreground="{StaticResource Ink}" FontWeight="SemiBold" />
        <TextBlock Text="  ·  拖动排序，点击快捷键框后直接按键"
                   Foreground="{StaticResource SubtleInk}" FontSize="11.5" VerticalAlignment="Center" />
      </StackPanel>
      <Button Content="＋  新增" HorizontalAlignment="Right" Width="88" Height="36"
              Style="{StaticResource SecondaryButtonStyle}" Click="AddAction_Click" />
    </Grid>

    <ScrollViewer x:Name="ActionsScrollViewer" Grid.Row="2" VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled" AllowDrop="True"
                  PreviewDragOver="ActionsScrollViewer_PreviewDragOver" Padding="0,0,7,0">
      <ItemsControl ItemsSource="{Binding Actions}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource SectionCard}" AllowDrop="True"
                    DragOver="ActionRow_DragOver" DragLeave="ActionRow_DragLeave" Drop="ActionRow_Drop">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition Width="56" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Border Grid.Column="0" Width="26" Height="40" Background="Transparent" Cursor="SizeAll"
                          Tag="{Binding}" ToolTip="按住拖动调整顺序" AutomationProperties.Name="拖动此按钮调整顺序"
                          MouseLeftButtonDown="DragHandle_MouseLeftButtonDown" MouseMove="DragHandle_MouseMove"
                          MouseLeftButtonUp="DragHandle_MouseLeftButtonUp">
                    <TextBlock Text="⠿" FontSize="20" Foreground="{StaticResource SubtleInk}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <CheckBox Grid.Column="1" Content="显示" IsChecked="{Binding Enabled}"
                            VerticalAlignment="Center" FontSize="11.5"
                            ToolTip="关闭后保留配置，但不在外部菜单展示" />
                  <TextBox Grid.Column="2" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                           MaxLength="32" AutomationProperties.Name="按钮名称" />
                  <Button Grid.Column="3" Content="↑" Style="{StaticResource SmallIconButton}"
                          Margin="8,0,0,0" Tag="{Binding}" Click="MoveUp_Click" ToolTip="上移" />
                  <Button Grid.Column="4" Content="↓" Style="{StaticResource SmallIconButton}"
                          Margin="6,0,0,0" Tag="{Binding}" Click="MoveDown_Click" ToolTip="下移" />
                  <Button Grid.Column="5" Content="删除" Height="34" Margin="6,0,0,0" Padding="10,4"
                          Style="{StaticResource MenuUtilityButtonStyle}" Foreground="{StaticResource Danger}"
                          Tag="{Binding}" Click="RemoveAction_Click" />
                </Grid>

                <Grid Margin="86,11,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="74" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="执行按键" VerticalAlignment="Center" Foreground="{StaticResource MutedInk}"
                             FontSize="12" />
                  <TextBox Grid.Column="1" Style="{StaticResource RecorderBox}"
                           Text="{Binding Shortcut, UpdateSourceTrigger=PropertyChanged}" Tag="{Binding}"
                           PreviewKeyDown="Hotkey_PreviewKeyDown" PreviewKeyUp="Hotkey_PreviewKeyUp"
                           AutomationProperties.AutomationId="ExecuteShortcut"
                           AutomationProperties.Name="录制或手动输入执行快捷键" />
                  <Border Grid.Column="2" Background="#141A28" CornerRadius="8" Padding="8,4" Margin="8,0,0,0"
                          VerticalAlignment="Center">
                    <TextBlock Text="必填" Foreground="{StaticResource SubtleInk}" FontSize="10.5" />
                  </Border>
                </Grid>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <Border Grid.Row="3" Background="#171D2A" BorderBrush="{StaticResource Stroke}" BorderThickness="1"
            CornerRadius="10" Padding="11,8" Margin="0,10,7,0">
      <Grid>
        <Ellipse Width="6" Height="6" Fill="{StaticResource Accent}" HorizontalAlignment="Left"
                 VerticalAlignment="Top" Margin="0,5,0,0" />
        <TextBlock x:Name="ErrorText" Foreground="{StaticResource MutedInk}" FontSize="11.5"
                   Margin="14,0,0,0" TextWrapping="Wrap" MinHeight="18" />
      </Grid>
    </Border>

    <Grid Grid.Row="4" Margin="0,14,7,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="10" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Button Content="取消" Style="{StaticResource SecondaryButtonStyle}" Click="Cancel_Click"
              FontSize="13" AutomationProperties.Name="取消快捷操作设置" />
      <Button Grid.Column="2" Content="应用设置" Style="{StaticResource PrimaryButtonStyle}"
              Click="Save_Click" FontSize="13" AutomationProperties.Name="应用快捷操作设置" />
    </Grid>
  </Grid>
</Window>
