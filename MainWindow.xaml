<Window x:Class="LunaDesktopHelper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="远程助手" Width="88" Height="88"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" ShowActivated="False"
        Topmost="True" Loaded="Window_Loaded">
  <Border x:Name="Shell" Background="{StaticResource Panel}" CornerRadius="44" BorderBrush="#687B8B9E" BorderThickness="1"
          ToolTip="远程助手：左键单击展开菜单；拖动可移动。"
          MouseLeftButtonDown="Shell_MouseLeftButtonDown" MouseLeftButtonUp="Shell_MouseLeftButtonUp">
    <Grid>
      <Grid x:Name="Capsule" Cursor="Hand" AutomationProperties.Name="远程助手，左键单击展开菜单">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
          <Border Width="38" Height="38" CornerRadius="19" Background="#30463743" HorizontalAlignment="Center">
            <Path Width="23" Height="23" Stretch="Uniform" Stroke="{StaticResource Accent}"
                  StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                  HorizontalAlignment="Center" VerticalAlignment="Center"
                  Data="M3,5 H21 V17 H3 Z M8,21 H16 M12,17 V21" />
          </Border>
          <TextBlock Text="远程助手" Foreground="{StaticResource Ink}" FontSize="12" FontWeight="SemiBold"
                     HorizontalAlignment="Center" Margin="0,4,0,0" />
        </StackPanel>
      </Grid>
      <ScrollViewer x:Name="Menu" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled" Margin="14,12,8,12">
      <StackPanel x:Name="MenuContent" Margin="0,0,6,0">
        <Grid Height="44" Margin="1,0,0,12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="44" />
            <ColumnDefinition Width="44" />
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="远程助手" Foreground="{StaticResource Ink}" FontSize="15" FontWeight="SemiBold" />
            <TextBlock Text="远程桌面快捷操作" Foreground="{StaticResource MutedInk}" FontSize="11" Margin="0,2,0,0" />
          </StackPanel>
          <Button Grid.Column="1" Style="{StaticResource MenuIconButtonStyle}"
                  Click="ActionSettings_Click" ToolTip="管理快捷操作和组合键"
                  AutomationProperties.Name="管理快捷操作和组合键">
            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="17"
                       Foreground="{StaticResource Ink}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Button>
          <Button Grid.Column="2" Style="{StaticResource MenuIconButtonStyle}"
                  Click="Collapse_Click" ToolTip="收起菜单" AutomationProperties.Name="收起菜单">
            <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                       Foreground="{StaticResource Ink}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Button>
        </Grid>

        <TextBlock Text="快捷操作" Foreground="{StaticResource Accent}" FontSize="11"
                   FontWeight="SemiBold" Margin="2,0,0,8" />

        <StackPanel x:Name="ActionsPanel" />

        <TextBlock x:Name="StatusText" Text="操作后菜单保持展开，可手动收起。"
                   Foreground="{StaticResource MutedInk}" FontSize="10.5" TextWrapping="Wrap"
                   Margin="3,10,3,0" MinHeight="28" VerticalAlignment="Center" />

        <Button Style="{StaticResource MenuUtilityButtonStyle}" Click="Collapse_Click"
                Margin="0,8,0,0" AutomationProperties.Name="收起菜单">
          <Grid>
            <TextBlock Text="收起菜单" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <TextBlock Text="⌃" HorizontalAlignment="Right" VerticalAlignment="Center"
                       Foreground="{StaticResource MutedInk}" FontSize="14" Margin="0,0,3,0" />
          </Grid>
        </Button>

        <Button x:Name="ExitButton" Style="{StaticResource MenuUtilityButtonStyle}" Click="Exit_Click"
                Margin="0,8,0,0" Foreground="#FFB4A9" BorderBrush="#664A4A"
                ToolTip="退出远程助手"
                AutomationProperties.Name="退出远程助手">
          <Grid>
            <TextBlock Text="退出助手" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <TextBlock Text="⏻" HorizontalAlignment="Right" VerticalAlignment="Center"
                       Foreground="#FFB4A9" FontSize="14" Margin="0,0,3,0" />
          </Grid>
        </Button>
      </StackPanel>
      </ScrollViewer>
    </Grid>
  </Border>
</Window>
