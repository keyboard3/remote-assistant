<Window x:Class="LunaDesktopHelper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="远程助手" Width="88" Height="88"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" ShowActivated="False"
        Topmost="True" Loaded="Window_Loaded">
  <Border x:Name="Shell" Background="{StaticResource Panel}" CornerRadius="44"
          BorderBrush="#59667994" BorderThickness="1"
          ToolTip="远程助手：单击展开；拖动可移动。"
          MouseLeftButtonDown="Shell_MouseLeftButtonDown" MouseLeftButtonUp="Shell_MouseLeftButtonUp">
    <Border.Effect>
      <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.38" Color="#050711" />
    </Border.Effect>
    <Grid>
      <Grid x:Name="Capsule" Cursor="Hand" AutomationProperties.Name="远程助手，单击展开菜单">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
          <Border Width="42" Height="42" CornerRadius="14" Background="{StaticResource AccentSoft}"
                  BorderBrush="#4D648FD8" BorderThickness="1" HorizontalAlignment="Center">
            <Grid Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Path Stroke="{StaticResource Accent}" StrokeThickness="1.8" StrokeStartLineCap="Round"
                    StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform"
                    Data="M3,4.5 H21 V16.5 H3 Z M8,21 H16 M12,16.5 V21" />
              <Ellipse Width="4" Height="4" Fill="{StaticResource Accent}" HorizontalAlignment="Right"
                       VerticalAlignment="Top" Margin="0,2,1,0" />
            </Grid>
          </Border>
          <TextBlock Text="助手" Foreground="{StaticResource Ink}" FontSize="11" FontWeight="SemiBold"
                     HorizontalAlignment="Center" Margin="0,5,0,0" />
        </StackPanel>
      </Grid>

      <ScrollViewer x:Name="Menu" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled" Margin="16,15,10,14">
        <StackPanel x:Name="MenuContent" Margin="0,0,6,0">
          <Grid Height="34" Margin="1,0,0,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="34" />
              <ColumnDefinition Width="34" />
            </Grid.ColumnDefinitions>
            <Border Width="30" Height="30" CornerRadius="10" Background="{StaticResource AccentSoft}"
                    VerticalAlignment="Center" Margin="0,0,8,0">
              <Path Width="16" Height="16" Stretch="Uniform" Stroke="{StaticResource Accent}"
                    StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                    StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Data="M3,4.5 H21 V16.5 H3 Z M8,21 H16 M12,16.5 V21" />
            </Border>
            <TextBlock Grid.Column="1" Text="远程助手" Foreground="{StaticResource Ink}" FontSize="14"
                       FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button Grid.Column="2" Style="{StaticResource MenuUtilityButtonStyle}" Padding="0"
                    Click="ActionSettings_Click" ToolTip="管理快捷操作"
                    AutomationProperties.Name="管理快捷操作和组合键">
              <Path Width="17" Height="17" Stretch="Uniform" Stroke="{StaticResource MutedInk}"
                    StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeLineJoin="Round"
                    Data="M12,8.5 A3.5,3.5 0 1 0 12,15.5 A3.5,3.5 0 1 0 12,8.5 M12,2 V5 M12,19 V22 M2,12 H5 M19,12 H22 M4.9,4.9 L7,7 M17,17 L19.1,19.1 M19.1,4.9 L17,7 M7,17 L4.9,19.1" />
            </Button>
            <Button Grid.Column="3" Style="{StaticResource MenuUtilityButtonStyle}" Padding="0"
                    Click="Collapse_Click" ToolTip="收起菜单" AutomationProperties.Name="收起菜单">
              <Path Width="14" Height="14" Stretch="Uniform" Stroke="{StaticResource MutedInk}"
                    StrokeThickness="1.8" StrokeStartLineCap="Round"
                    Data="M4,4 L20,20 M20,4 L4,20" />
            </Button>
          </Grid>

          <Grid Margin="2,0,2,9">
            <TextBlock Text="快捷操作" Foreground="{StaticResource MutedInk}" FontSize="10.5"
                       FontWeight="SemiBold" VerticalAlignment="Center" />
            <Border x:Name="ActionsHintBadge" HorizontalAlignment="Right" Background="{StaticResource AccentSoft}"
                    CornerRadius="8" Padding="7,3">
              <TextBlock Text="点击执行" Foreground="{StaticResource Accent}" FontSize="9.5" />
            </Border>
          </Grid>

          <StackPanel x:Name="ActionsPanel" />

          <Border Background="#101521" CornerRadius="10" Padding="10,8" Margin="0,1,0,0">
            <TextBlock x:Name="StatusText" Text="操作后菜单会保持展开。"
                       Foreground="{StaticResource MutedInk}" FontSize="10.5" TextWrapping="Wrap"
                       MinHeight="18" VerticalAlignment="Center" />
          </Border>

          <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="8" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource MenuUtilityButtonStyle}" Click="Collapse_Click"
                    AutomationProperties.Name="收起菜单">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="⌃" Foreground="{StaticResource MutedInk}" FontSize="13" Margin="0,0,7,0" />
                <TextBlock Text="收起" />
              </StackPanel>
            </Button>
            <Button x:Name="ExitButton" Grid.Column="2" Style="{StaticResource MenuUtilityButtonStyle}"
                    Click="Exit_Click" Foreground="{StaticResource Danger}" ToolTip="退出远程助手"
                    AutomationProperties.Name="退出远程助手">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="×" FontSize="16" FontWeight="Light" Margin="0,-1,7,0" />
                <TextBlock Text="退出" />
              </StackPanel>
            </Button>
          </Grid>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Border>
</Window>
