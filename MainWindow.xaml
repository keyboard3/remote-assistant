<Window x:Class="LunaDesktopHelper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="远程助手" Width="88" Height="88"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" ShowActivated="False"
        Topmost="True" Loaded="Window_Loaded" Closing="Window_Closing">
  <Border x:Name="Shell" Background="{StaticResource Panel}" CornerRadius="44" BorderBrush="#687B8B9E" BorderThickness="1"
          ToolTip="远程助手：左键单击展开菜单；拖动可移动。"
          MouseLeftButtonDown="Shell_MouseLeftButtonDown" MouseLeftButtonUp="Shell_MouseLeftButtonUp">
    <Grid>
      <Grid x:Name="Capsule" Cursor="Hand" AutomationProperties.Name="远程助手，左键单击展开菜单">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
          <Border Width="38" Height="38" CornerRadius="19" Background="#30463743" HorizontalAlignment="Center">
            <Path Width="23" Height="23" Stretch="Uniform" Stroke="{StaticResource Accent}"
                  StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                  HorizontalAlignment="Center" VerticalAlignment="Center"
                  Data="M3,5 H21 V17 H3 Z M8,21 H16 M12,17 V21" />
          </Border>
          <TextBlock Text="远程助手" Foreground="{StaticResource Ink}" FontSize="12" FontWeight="SemiBold"
                     HorizontalAlignment="Center" Margin="0,4,0,0" />
        </StackPanel>
      </Grid>
      <StackPanel x:Name="Menu" Visibility="Collapsed" Margin="14,12,14,12">
        <Grid Height="44" Margin="1,0,0,12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="44" />
            <ColumnDefinition Width="44" />
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="远程助手" Foreground="{StaticResource Ink}" FontSize="15" FontWeight="SemiBold" />
            <TextBlock Text="远程桌面快捷操作" Foreground="{StaticResource MutedInk}" FontSize="11" Margin="0,2,0,0" />
          </StackPanel>
          <Button Grid.Column="1" Style="{StaticResource MenuUtilityButtonStyle}" Padding="0"
                  Click="ActionSettings_Click" ToolTip="设置第三个快捷操作"
                  AutomationProperties.Name="设置动作名称和快捷键">
            <TextBlock Text="⚙" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Button>
          <Button Grid.Column="2" Style="{StaticResource MenuUtilityButtonStyle}" Padding="0"
                  Click="Collapse_Click" ToolTip="收起菜单" AutomationProperties.Name="收起菜单">
            <TextBlock Text="×" FontSize="24" FontWeight="Light" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Button>
        </Grid>

        <TextBlock Text="快捷操作" Foreground="{StaticResource Accent}" FontSize="11"
                   FontWeight="SemiBold" Margin="2,0,0,8" />

        <Button x:Name="CaptureButton" Style="{StaticResource MenuActionButtonStyle}"
                Click="Capture_Click" AutomationProperties.Name="区域截图，截图后复制到剪贴板">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="40" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="16" />
            </Grid.ColumnDefinitions>
            <Border Width="38" Height="38" CornerRadius="11" Background="#30463743" VerticalAlignment="Center">
              <Path Width="20" Height="20" Stretch="Uniform" Stroke="{StaticResource Accent}"
                    StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                    Data="M10,1 V5 M10,15 V19 M1,10 H5 M15,10 H19 M6,6 H14 V14 H6 Z" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,4,0">
              <TextBlock Text="区域截图" Foreground="{StaticResource Ink}" FontSize="14" FontWeight="SemiBold" />
              <TextBlock Text="截取画面并复制到剪贴板" Foreground="{StaticResource MutedInk}"
                         FontSize="10.5" Margin="0,3,0,0" />
            </StackPanel>
            <TextBlock Grid.Column="2" Text="›" Foreground="#A8B3C3" FontSize="24"
                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,1,3" />
          </Grid>
        </Button>

        <Button x:Name="CaptureRecoveryButton" Style="{StaticResource MenuActionButtonStyle}"
                Click="EndCaptureWait_Click" Visibility="Collapsed"
                AutomationProperties.Name="结束截图等待并重新启用截图">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="40" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="16" />
            </Grid.ColumnDefinitions>
            <Border Width="38" Height="38" CornerRadius="11" Background="#30463743" VerticalAlignment="Center">
              <TextBlock Text="↻" Foreground="{StaticResource Accent}" FontSize="23"
                         HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,4,0">
              <TextBlock Text="结束截图等待" Foreground="{StaticResource Ink}" FontSize="14" FontWeight="SemiBold" />
              <TextBlock Text="取消后点此恢复截图按钮" Foreground="{StaticResource MutedInk}"
                         FontSize="10.5" Margin="0,3,0,0" />
            </StackPanel>
            <TextBlock Grid.Column="2" Text="›" Foreground="#A8B3C3" FontSize="24"
                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,1,3" />
          </Grid>
        </Button>

        <Button x:Name="PasteButton" Style="{StaticResource MenuActionButtonStyle}"
                PreviewMouseLeftButtonDown="PasteButton_PreviewMouseLeftButtonDown"
                PreviewMouseLeftButtonUp="PasteButton_PreviewMouseLeftButtonUp"
                Margin="0,10,0,0"
                ToolTip="先让目标输入框获得焦点；把剪贴板图片作为 PNG 文件投递。"
                AutomationProperties.Name="投递图片到当前应用">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="40" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="16" />
            </Grid.ColumnDefinitions>
            <Border Width="38" Height="38" CornerRadius="11" Background="#30463743" VerticalAlignment="Center">
              <Path Width="19" Height="21" Stretch="Uniform" Stroke="{StaticResource Accent}"
                    StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                    Data="M7,4 H5 V20 H17 V4 H14 M8,2 H13 V6 H8 Z M8,11 H14 M8,15 H14" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,4,0">
              <TextBlock Text="投递到当前应用" Foreground="{StaticResource Ink}" FontSize="14" FontWeight="SemiBold" />
              <TextBlock Text="先聚焦输入框，再投递 PNG 文件" Foreground="{StaticResource MutedInk}"
                         FontSize="10.5" Margin="0,3,0,0" />
            </StackPanel>
            <TextBlock Grid.Column="2" Text="›" Foreground="#A8B3C3" FontSize="24"
                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,1,3" />
          </Grid>
        </Button>

        <Button x:Name="TypelessButton" Style="{StaticResource MenuActionButtonStyle}"
                Click="Typeless_Click" Margin="0,10,0,0"
                ToolTip="先点选目标输入框，再向该应用发送已配置的快捷键。"
                AutomationProperties.Name="快捷操作，发送已配置的单次快捷键">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="40" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="16" />
            </Grid.ColumnDefinitions>
            <Border Width="38" Height="38" CornerRadius="11" Background="#30463743" VerticalAlignment="Center">
              <TextBlock Text="♫" Foreground="{StaticResource Accent}" FontSize="21"
                         HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,4,0">
              <TextBlock x:Name="TypelessTitleText" Text="Typeless 语音输入" Foreground="{StaticResource Ink}" FontSize="14" FontWeight="SemiBold" />
              <TextBlock x:Name="TypelessHotkeyText" Text="先聚焦输入框 · Right Alt" Foreground="{StaticResource MutedInk}"
                         FontSize="10.5" Margin="0,3,0,0" />
            </StackPanel>
            <TextBlock Grid.Column="2" Text="›" Foreground="#A8B3C3" FontSize="24"
                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,1,3" />
          </Grid>
        </Button>

        <TextBlock x:Name="StatusText" Text="操作后菜单保持展开，可手动收起。"
                   Foreground="{StaticResource MutedInk}" FontSize="10.5" TextWrapping="Wrap"
                   Margin="3,10,3,0" MinHeight="28" VerticalAlignment="Center" />

        <Button Style="{StaticResource MenuUtilityButtonStyle}" Click="Collapse_Click"
                Margin="0,8,0,0" AutomationProperties.Name="收起菜单">
          <Grid>
            <TextBlock Text="收起菜单" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <TextBlock Text="⌃" HorizontalAlignment="Right" VerticalAlignment="Center"
                       Foreground="{StaticResource MutedInk}" FontSize="14" Margin="0,0,3,0" />
          </Grid>
        </Button>
      </StackPanel>
    </Grid>
  </Border>
</Window>
